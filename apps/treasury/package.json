{
  "name": "@baobu/treasury",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:exec --only auth,firestore --project demo-baobu-kingdom --ui \"vite --mode emulators\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "firebase emulators:exec --only firestore --project demo-baobu-kingdom \"vitest run\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@baobu/core": "workspace:*",
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "15.34.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
